{
  "name": "HIMMER — Printing, made effortless.",
  "short_name": "HIMMER",
  "description": "HIMMER is effortless printing software for scanning a shop QR, uploading documents, paying securely via UPI, and collecting prints.",
  "id": "/",
  "start_url": "/app/home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0E1117",
  "theme_color": "#0C831F",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Scan a printer",
      "short_name": "Scan now",
      "url": "/app/scan",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/png",
            ".png"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "maskable"
    }
  ]
}
