[Unit]
Description=PrintBuddy Print Agent
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/printbuddy-agent
EnvironmentFile=/home/pi/printbuddy-agent/.env
ExecStart=/usr/bin/python3 /home/pi/printbuddy-agent/agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
